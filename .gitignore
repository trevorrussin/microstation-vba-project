# Ignore Claude AI extension data
.claude/

# Ignore VS Code workspace settings
.vscode/

# Ignore .NET/VBA build/cache folders
bin/
obj/

# Ignore temporary files
*.tmp
*.log

# Ignore system files
Thumbs.db
.DS_Store

# WZTC agent bridge — runtime request/response/journal files (M1+)
Bridge/*.tsv

# Python MCP server (M5) — cache and local venvs, not source
mcp-server/__pycache__/
mcp-server/.venv/
mcp-server/venv/

# Large reference PDFs (~66MB total) — kept locally for reference, not in git
Project Documentation/2026_1_stdsht_usc_book_3.pdf
Project Documentation/B-2011Supplement-adopted.pdf
Project Documentation/part6.pdf

# M7 — FTS5 index built from the reference PDFs above (regenerate via
# mcp-server/ingest_manuals.py); chat-panel conversation history
Data/manual-index.sqlite
Bridge/chat-history.json

# M7 — real API key file (see mcp-server/.env.example for the template).
# NEVER remove this line or commit the real .env.
mcp-server/.env

# View-capture screenshots (may show real project/client path in the
# MicroStation title bar) and archived chat history — runtime output, not source.
Bridge/captures/
Bridge/archive/

# Reference .ts files dropped in Project Documentation for prompt-injection
# pattern reference only -- from a different (TypeScript/web) project, not
# part of this repo's source.
Project Documentation/*.ts

# Regenerable key-in probe output (scripts/keyin_batch.py) -- rerun
# `python scripts/keyin_batch.py probe` to reproduce; see scripts/README.md.
Bridge/keyin-probe-batch.json
Bridge/keyin-probe-results.json

# Regenerable drawing-recipe probe output (scripts/recipe_batch.py) -- same
# category as the keyin probe output above.
Bridge/recipe-probe-batch.json

# Regenerable eval-harness output (mcp-server/eval_harness.py) -- same
# category as the probe outputs above; also excludes its isolated chat log.
Bridge/eval-results*.json
Bridge/eval-log.tsv

# Regenerable key-in false-OK audit output (scripts/keyin_false_ok_audit.py)
# -- same category as the probe outputs above; rerun with `run --scope
# all-gated` to reproduce.
Bridge/keyin-false-ok-audit.json

# WZTC chat agent session-mode persistence (mcp-server/chat_driver.py) and
# one-off debug script output -- runtime state, not source.
Bridge/chat-session-mode.txt
Bridge/debug-ref-scan*.txt

# Sheet-build session/runtime state and ad-hoc debug/watch output -- not
# source, same category as the Bridge/* rules above.
Bridge/.monitor-baseline-bytes.txt
Bridge/.monitor-last-ts.txt
Bridge/_agent_watch.txt
Bridge/_all_levels.txt
Bridge/chat-history.pre*.bak.json
Bridge/chat-history.prev.json
Bridge/last-build-conversation.md
Bridge/placement-registry.jsonl
Bridge/sheet-plan.json
Bridge/sheet-reflection.jsonl
Bridge/last-agent-kickoff-prompt.txt
Bridge/build-ledger.jsonl
Bridge/_ping.txt
Bridge/_stale_text_ids.json

# Python bytecode cache, any location
__pycache__/