# Ignore Claude AI extension data
.claude/

# Ignore VS Code workspace settings
.vscode/

# Ignore .NET/VBA build/cache folders
bin/
obj/

# Ignore temporary files
*.tmp
*.log

# Ignore system files
Thumbs.db
.DS_Store

# WZTC agent bridge — runtime request/response/journal files (M1+)
Bridge/*.tsv

# Python MCP server (M5) — cache and local venvs, not source
mcp-server/__pycache__/
mcp-server/.venv/
mcp-server/venv/

# Large reference PDFs (~66MB total) — kept locally for reference, not in git
Project Documentation/2026_1_stdsht_usc_book_3.pdf
Project Documentation/B-2011Supplement-adopted.pdf
Project Documentation/part6.pdf

# M7 — FTS5 index built from the reference PDFs above (regenerate via
# mcp-server/ingest_manuals.py); chat-panel conversation history
Data/manual-index.sqlite
Bridge/chat-history.json

# M7 — real API key file (see mcp-server/.env.example for the template).
# NEVER remove this line or commit the real .env.
mcp-server/.env

# Reference .ts files dropped in Project Documentation for prompt-injection
# pattern reference only -- from a different (TypeScript/web) project, not
# part of this repo's source.
Project Documentation/*.ts

# Regenerable key-in probe output (scripts/keyin_batch.py) -- rerun
# `python scripts/keyin_batch.py probe` to reproduce; see scripts/README.md.
Bridge/keyin-probe-batch.json
Bridge/keyin-probe-results.json

# Python bytecode cache, any location
__pycache__/